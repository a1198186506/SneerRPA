[
  {
    "type": "app.launch",
    "name": "运行或打开",
    "group": "窗口管理",
    "icon": "↗",
    "description": "选择程序或文件，配置可选启动参数",
    "fields": [
      {
        "key": "path",
        "label": "程序或文件路径",
        "default": "notepad.exe",
        "required": true,
        "kind": "file"
      },
      {
        "key": "args",
        "label": "参数列表（JSON 数组）",
        "kind": "json",
        "default": [],
        "help": "不需要启动参数时保留 []；例如 [\"F:/demo.txt\"] 表示打开指定文件。"
      },
      {
        "key": "output",
        "label": "进程变量名",
        "default": "app_process",
        "kind": "variable"
      }
    ]
  },
  {
    "type": "window.get",
    "name": "获取窗口对象",
    "group": "窗口管理",
    "icon": "▣",
    "description": "通过元素库、窗口变量或窗口条件获取窗口",
    "fields": [
      {
        "key": "target_mode",
        "label": "窗口获取方式",
        "kind": "select",
        "options": [
          [
            "element",
            "从元素库获取所属窗口"
          ],
          [
            "variable",
            "使用窗口变量"
          ],
          [
            "criteria",
            "按窗口条件查找"
          ]
        ],
        "default": "element"
      },
      {
        "key": "element",
        "label": "定位窗口的元素",
        "kind": "element",
        "default": "",
        "show_if": {
          "target_mode": [
            "element"
          ]
        }
      },
      {
        "key": "window",
        "label": "窗口变量",
        "default": "main_window",
        "required": true,
        "show_if": {
          "target_mode": [
            "variable"
          ]
        }
      },
      {
        "key": "title",
        "label": "窗口标题",
        "default": "",
        "show_if": {
          "target_mode": [
            "criteria"
          ]
        }
      },
      {
        "key": "match",
        "label": "标题匹配方式",
        "kind": "select",
        "options": [
          [
            "exact",
            "完全匹配"
          ],
          [
            "contains",
            "包含"
          ],
          [
            "regex",
            "正则表达式"
          ]
        ],
        "default": "exact",
        "show_if": {
          "target_mode": [
            "criteria"
          ]
        }
      },
      {
        "key": "class_name",
        "label": "窗口类名（可选）",
        "default": "",
        "show_if": {
          "target_mode": [
            "criteria"
          ]
        },
        "advanced": true
      },
      {
        "key": "process_name",
        "label": "进程名（可选）",
        "default": "",
        "show_if": {
          "target_mode": [
            "criteria"
          ]
        },
        "advanced": true
      },
      {
        "key": "process_id",
        "label": "进程 ID（可选，支持 ${进程变量}）",
        "default": "",
        "show_if": {
          "target_mode": [
            "criteria"
          ]
        },
        "advanced": true
      },
      {
        "key": "backend",
        "label": "自动化后端",
        "kind": "select",
        "options": [
          [
            "uia",
            "UI Automation"
          ],
          [
            "win32",
            "Win32"
          ]
        ],
        "default": "uia",
        "show_if": {
          "target_mode": [
            "criteria"
          ]
        },
        "advanced": true
      },
      {
        "key": "output",
        "label": "窗口变量名",
        "default": "main_window",
        "kind": "variable",
        "required": true
      },
      {
        "key": "timeout",
        "label": "超时时间（秒）",
        "kind": "number",
        "default": 10,
        "min": 0,
        "max": 120,
        "advanced": true
      }
    ]
  },
